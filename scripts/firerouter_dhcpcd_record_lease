#!/bin/bash

# NOTE: log() is defined in firerouter_dhcpcd_common, which dhcpcd-run-hooks
# sources before this script (alphabetical order: common < record_lease).
# Do NOT rename firerouter_dhcpcd_common in a way that breaks that ordering.

# Seconds left on something granted $1 seconds at timestamp $2 - elapsed-time subtraction only,
# floored at 0. Prints nothing if the input is unusable (unknown), otherwise always prints a
# number - 0 included, since an expired lease is known to be gone, not unknown.
elapsed_lifetime() {
  granted=$1
  granted_ts=$2
  case "$granted" in ''|*[!0-9]*) return 0;; esac
  case "$granted_ts" in ''|*[!0-9]*) return 0;; esac
  left=$((granted - ($(date +%s) - granted_ts)))
  if [ $left -lt 0 ]; then
    left=0
  fi
  echo $left
}

# Seconds left to keep advertising a prefix that is actually being withdrawn: elapsed_lifetime
# capped at the 2 hour ceiling a host honours anyway (RFC 4862 5.5.3(e)). Only for that withdrawal
# case - carrying a still-valid lease forward wants elapsed_lifetime above, uncapped.
remaining_lifetime() {
  left=$(elapsed_lifetime "$1" "$2")
  [ -z "$left" ] && return 0
  if [ "$left" -gt 7200 ]; then
    left=7200
  fi
  echo $left
}

check_is_private_address() {
  if [ -z "$interface" ]; then
    log "check_is_private_addr: interface is empty"
    return 1
  fi
  ipv4_address=$(ip -4 addr show dev "$interface" 2>/dev/null | grep -oP 'inet\s+\K[\d.]+' | head -n 1)

  if [ -z "$ipv4_address" ]; then
    log "check_is_private_addr: no IPv4 address on $interface"
    return 1
  fi

  first_octet=$(echo "$ipv4_address" | cut -d'.' -f1)
  second_octet=$(echo "$ipv4_address" | cut -d'.' -f2)

  # A Class private: 10.0.0.0/8
  if [ "$first_octet" -eq 10 ]; then
    log "check_is_private_addr: $interface $ipv4_address is private (10.0.0.0/8)"
    return 0
  fi

  # B Class private: 172.16.0.0/12
  if [ "$first_octet" -eq 172 ] && [ "$second_octet" -ge 16 ] && [ "$second_octet" -le 31 ]; then
    log "check_is_private_addr: $interface $ipv4_address is private (172.16.0.0/12)"
    return 0
  fi

  # C Class private: 192.168.0.0/16
  if [ "$first_octet" -eq 192 ] && [ "$second_octet" -eq 168 ]; then
    log "check_is_private_addr: $interface $ipv4_address is private (192.168.0.0/16)"
    return 0
  fi

  log "check_is_private_addr: $interface $ipv4_address is not private"
  return 1
}

case $reason in
  ROUTERADVERT)
    log "ROUTERADVERT interface=$interface ra_dump:\n$(env | grep -E '^nd[0-9]+_' | sort)"

    # Read the previous record before it is overwritten below - a changed prefix is a renumbering,
    # and the LAN side keeps advertising the old one at zero preferred lifetime (RFC 4861 sect 12).
    prev_ra=$(cat /dev/shm/dhcpcd.ra.$interface 2>/dev/null)
    prev_prefix=$(echo "$prev_ra" | sed -n 's/^prefix=//p')
    prev_ra_vltime=$(echo "$prev_ra" | sed -n 's/^ra_vltime=//p')
    prev_ra_pltime=$(echo "$prev_ra" | sed -n 's/^ra_pltime=//p')
    prev_ra_ts=$(echo "$prev_ra" | sed -n 's/^ra_ts=//p')

    # If the IPv6 address of the upstream router changes, 
    # we may recieve sevaral groups of nd_* variables, take the last complete ND option set.
    nd_id=10
    gw6=""
    vltime=""

    check_is_private_address
    IS_PRIVATE_ADDR=$?

    # fallback_gw6: best candidate when router RA fields is present but lifetime=0
    fallback_gw6=""
    fallback_nd_id=0
    while [ $nd_id -gt 0 ]; do
      nd_name="nd${nd_id}_from"
      eval "nd_from_val=\$$nd_name"

      if [ -n "$nd_from_val" ]; then
        # interface to ISP should not recieve RA which only include "Route Information" from IOT gateway
        if [ "$IS_PRIVATE_ADDR" -ne 0 ]; then
          gw6="$nd_from_val"
          break
        fi
        # otherwise check other value
        eval "nd_mtu_val=\$nd${nd_id}_mtu"
        eval "nd_rdnss1_servers_val=\$nd${nd_id}_rdnss1_servers"
        eval "nd_addr1_val=\$nd${nd_id}_addr1"
        eval "nd_source_val=\$nd${nd_id}_source_address"
        eval "nd_lifetime_val=\$nd${nd_id}_lifetime"
        if [ -n "$nd_mtu_val" ] || [ -n "$nd_rdnss1_servers_val" ] || [ -n "$nd_addr1_val" ] || [ -n "$nd_source_val" ]; then
          if [ "${nd_lifetime_val:-0}" != "0" ]; then
            # ideal: has router RA fields and non-zero lifetime
            log "select gw6: nd$nd_id ($nd_from_val) selected (mtu=$nd_mtu_val rdnss=$nd_rdnss1_servers_val addr=$nd_addr1_val source=$nd_source_val lifetime=$nd_lifetime_val)"
            gw6="$nd_from_val"
            break
          elif [ -z "$fallback_gw6" ]; then
            # has router RA fields but lifetime=0, keep as fallback
            log "select gw6: nd$nd_id ($nd_from_val) has router RA fields but lifetime=0, recorded as fallback"
            fallback_gw6="$nd_from_val"
            fallback_nd_id=$nd_id
          fi
        else
          log "select gw6: nd$nd_id ($nd_from_val) has no router RA fields, skipping"
        fi
      fi
      nd_id=$((nd_id - 1))
    done

    # No ideal nd found; fall back to one with router RA fields but lifetime=0
    if [ -z "$gw6" ] && [ -n "$fallback_gw6" ]; then
      log "select gw6: fallback to nd$fallback_nd_id ($fallback_gw6) with lifetime=0"
      gw6="$fallback_gw6"
      nd_id=$fallback_nd_id
    fi

    # If no suitable nd_from was found but only one set exists (nd1_from), use it and set nd_id=1
    if [ -z "$gw6" ]; then
      eval "nd1_from_val=\$nd1_from"
      if [ -n "$nd1_from_val" ]; then
        only_one=1
        check_id=2
        while [ $check_id -le 10 ]; do
          check_name="nd${check_id}_from"
          eval "check_val=\$$check_name"
          if [ -n "$check_val" ]; then
            only_one=0
            break
          fi
          check_id=$((check_id + 1))
        done
        if [ "$only_one" -eq 1 ]; then
          log "select gw6: fallback to the only nd1 ($nd1_from_val) despite no router RA fields"
          gw6="$nd1_from_val"
          nd_id=1
        fi
      fi
    fi

    # firerouter_dhcpcd_update_rt now using these
    RECORD_LEASE_GW6="$gw6"
    RECORD_LEASE_ND_ID="$nd_id"

    if [ -n "$gw6" ]; then
      new_addrs=""
      addr_id=10
      while [ $addr_id -gt 0 ]; do
        var_name="nd${nd_id}_addr$addr_id"
        eval "addr=\$$var_name"
        if [ -n "$addr" ]; then
          new_addrs="$addr"
          break
        fi
        addr_id=$((addr_id - 1))
      done

      # Find first SLAAC-capable (/A flag) prefix from the selected ND group.
      slaac_prefix=""
      vltime=""
      pltime=""
      pi_id=1
      while true; do
        eval "pi_prefix=\$nd${nd_id}_prefix_information${pi_id}_prefix"
        [ -z "$pi_prefix" ] && break
        eval "pi_flags=\$nd${nd_id}_prefix_information${pi_id}_flags"
        if echo "$pi_flags" | grep -qi 'a'; then
          slaac_prefix="$pi_prefix"
          eval "vltime=\$nd${nd_id}_prefix_information${pi_id}_vltime"
          eval "pltime=\$nd${nd_id}_prefix_information${pi_id}_pltime"
          break
        fi
        pi_id=$((pi_id + 1))
      done
      # No A-flag prefix here, but ra_vltime/ra_pltime are also read on their own, so keep the old source.
      if [ -z "$vltime" ]; then
        eval "vltime=\$nd${nd_id}_prefix_information1_vltime"
      fi
      if [ -z "$pltime" ]; then
        eval "pltime=\$nd${nd_id}_prefix_information1_pltime"
      fi

      # An RA need not carry a prefix option (router-lifetime refresh, second router on the link).
      # That is no information, not a withdrawal, so carry the last known values forward.
      ra_ts=$(date +%s)
      if [ -z "$slaac_prefix" ] && [ -n "$prev_prefix" ]; then
        slaac_prefix="$prev_prefix"
        vltime=$(elapsed_lifetime "$prev_ra_vltime" "$prev_ra_ts")
        pltime=$(elapsed_lifetime "$prev_ra_pltime" "$prev_ra_ts")
      fi

      # Sanitize before exporting: unparsable becomes empty (callers then leave the address
      # permanent, today's behavior), and pltime may never exceed vltime (RFC 4862 5.5.3(e)).
      case "$vltime" in ''|*[!0-9]*) vltime="";; esac
      case "$pltime" in ''|*[!0-9]*) pltime="";; esac
      if [ -z "$vltime" ]; then
        pltime=""
      elif [ "$vltime" -le 0 ]; then
        vltime="0"
        pltime="0"
      elif [ -z "$pltime" ] || [ "$pltime" -gt "$vltime" ]; then
        pltime="$vltime"
      fi
      # firerouter_dhcpcd_update_rt uses these to give the WAN self-address real lifetimes too.
      RECORD_LEASE_RA_VLTIME="$vltime"
      RECORD_LEASE_RA_PLTIME="$pltime"

      # After the carry-forward above slaac_prefix is empty only if no prefix was ever seen.
      if [ -n "$prev_prefix" ] && [ -n "$slaac_prefix" ] && [ "$prev_prefix" != "$slaac_prefix" ]; then
        left=$(remaining_lifetime "$prev_ra_vltime" "$prev_ra_ts")
        if [ -n "$left" ]; then
          echo "${prev_prefix}/64@$left," > /dev/shm/dhcpcd.ra_deprecated.$interface
        fi
      fi

      echo "ip6=$new_addrs\ngw6=$gw6\nra_vltime=$vltime\nra_pltime=$pltime\nra_ts=$ra_ts\nprefix=$slaac_prefix\n" > /dev/shm/dhcpcd.ra.$interface
    fi
    ;;
  BOUND6|REBOOT6|RENEW6|REBIND6)
    # Read the previous lease before it is overwritten below, see the ROUTERADVERT branch above -
    # a prefix that disappears from it is a renumbering, and its remaining lifetime bounds the RA.
    prev_lease=$(cat /dev/shm/dhcpcd.lease6.${interface} 2>/dev/null)
    prev_pd_vltimes=$(echo "$prev_lease" | sed -n 's/^ia_pd_vltimes=//p')
    prev_ts=$(echo "$prev_lease" | sed -n 's/^ts=//p')

    pd_id=1
    ia_pd_vltimes=""
    new_pds=""
    while [ $pd_id -lt 10 ]; do
      new_prefix_name="new_dhcp6_ia_pd1_prefix${pd_id}"
      eval "new_prefix=\$$new_prefix_name"
      new_prefix_length_name="new_dhcp6_ia_pd1_prefix${pd_id}_length"
      eval "new_prefix_length=\$$new_prefix_length_name"
      new_prefix_val="$new_prefix/$new_prefix_length"
      new_prefix_vltime_name="new_dhcp6_ia_pd1_prefix${pd_id}_vltime"
      eval "new_prefix_vltime=\$$new_prefix_vltime_name"
      if [ $new_prefix_val != "/" ]; then
        ia_pd_vltimes="$ia_pd_vltimes$new_prefix_val@$new_prefix_vltime,"
        new_pds="$new_pds $new_prefix_val"
      fi
      pd_id=$((pd_id + 1))
    done
    echo $ia_pd_vltimes > /dev/shm/dhcpcd.ia_pd_vltime.${interface}

    deprecated_pds=""
    # /dev/shm is world writable, so this record is untrusted: set -f stops a * in it from globbing,
    # and = keeps it from acting as a pattern. Restored after - later hooks share this shell.
    set -f
    for prev_entry in $(echo "$prev_pd_vltimes" | tr ',' ' '); do
      prev_pd=${prev_entry%@*}
      [ -n "$prev_pd" ] || continue
      still_leased=""
      for new_pd in $new_pds; do
        if [ "$new_pd" = "$prev_pd" ]; then
          still_leased=1
          break
        fi
      done
      [ -z "$still_leased" ] || continue
      left=$(remaining_lifetime "${prev_entry#*@}" "$prev_ts")
      [ -n "$left" ] || continue
      deprecated_pds="$deprecated_pds$prev_pd@$left,"
    done
    set +f
    # Never cleared: a renew must not wipe a record the LAN side has not consumed. Stale entries
    # no longer match any prefix and are skipped by the reader.
    if [ -n "$deprecated_pds" ]; then
      echo "$deprecated_pds" > /dev/shm/dhcpcd.pd_deprecated.${interface}
    fi

    addr_id=1
    ia_na_vltimes=""
    while [ $addr_id -lt 10 ]; do
      new_var_name="new_dhcp6_ia_na1_ia_addr$addr_id"
      eval "new_addr=\$$new_var_name"
      new_vltime_name="new_dhcp6_ia_na1_ia_addr${addr_id}_vltime"
      eval "new_vltime=\$$new_vltime_name"
      if [ -n "$new_addr" ]; then
        ia_na_vltimes="$ia_na_vltimes$new_addr@$new_vltime,"
      fi
      addr_id=$((addr_id + 1))
    done
    echo $ia_na_vltimes > /dev/shm/dhcpcd.ia_na_vltime.${interface}
    echo "ia_pd_vltimes=$ia_pd_vltimes\nia_na_vltimes=$ia_na_vltimes\nts=$(date +%s)" > /dev/shm/dhcpcd.lease6.${interface}
  ;;
esac